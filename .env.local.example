NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Pluggy (Open Finance) — https://dashboard.pluggy.ai → Applications
# Só no servidor: NUNCA use o prefixo NEXT_PUBLIC_ nestes dois.
PLUGGY_CLIENT_ID=your-pluggy-client-id
PLUGGY_CLIENT_SECRET=your-pluggy-client-secret
# true = mostra o banco de testes "Pluggy Bank" no widget (para testar sem banco real)
NEXT_PUBLIC_PLUGGY_SANDBOX=false

# Webhook da Pluggy (/api/webhooks/pluggy) — roda sem usuário logado.
# Supabase → Project Settings → API Keys → service_role (secreta; só no servidor).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opcional: se definida, o webhook exige o header x-webhook-secret com este valor.
PLUGGY_WEBHOOK_SECRET=
